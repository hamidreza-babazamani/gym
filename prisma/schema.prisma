generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  fullName     String         @map("full_name") @db.VarChar(120)
  email        String?        @unique @db.VarChar(255)
  phone        String?        @unique @db.VarChar(20)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  status       AccountStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  coaching     CoachStudent[] @relation("Coach")
  training     CoachStudent[] @relation("Student")
  roles        UserRole[]

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model CoachStudent {
  id        String             @id @default(uuid()) @db.Uuid
  coachId   String             @map("coach_id") @db.Uuid
  studentId String             @map("student_id") @db.Uuid
  status    CoachStudentStatus @default(PENDING)
  startedAt DateTime?          @map("started_at") @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  coach     User               @relation("Coach", fields: [coachId], references: [id], onDelete: Cascade)
  student   User               @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([coachId, studentId])
  @@index([coachId, status])
  @@index([studentId, status])
  @@map("coach_students")
}

enum Role {
  STUDENT
  COACH
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum CoachStudentStatus {
  PENDING
  ACTIVE
  REJECTED
}

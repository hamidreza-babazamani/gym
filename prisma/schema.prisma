// ==============================================
// Generator & Datasource
// ==============================================
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==============================================
// Enums
// ==============================================

enum Role {
  STUDENT
  COACH
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum CoachStudentStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELLED
  ENDED
}

enum CoachStudentInitiator {
  COACH
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ConversationType {
  PRIVATE
  GROUP
}

enum NotificationType {
  COACH_REQUEST
  COACH_REQUEST_RESPONSE
  NEW_MESSAGE
  PROGRAM_ASSIGNED
  PROGRAM_UPDATED
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  SYSTEM
}

// ==============================================
// User & Auth
// ==============================================

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  fullName           String        @map("full_name") @db.VarChar(120)
  email              String        @unique @db.VarChar(255)
  phone              String?       @unique @db.VarChar(20)
  passwordHash       String        @map("password_hash") @db.VarChar(255)
  status             AccountStatus @default(PENDING_VERIFICATION)
  
  emailVerifiedAt    DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  phoneVerifiedAt    DateTime?     @map("phone_verified_at") @db.Timestamptz(3)
  
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?     @map("password_changed_at") @db.Timestamptz(3)
  failedLoginCount   Int           @default(0) @map("failed_login_count")
  lockedUntil        DateTime?     @map("locked_until") @db.Timestamptz(3)
  
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(3)
  
  roles              UserRole[]
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  
  coaching           CoachStudent[] @relation("Coach")
  training           CoachStudent[] @relation("Student")
  
  memberships        Membership[]
  
  programs           Program[]
  programAssignments ProgramAssignment[]
  exerciseLogs       ExerciseLog[]
  
  ownedGroups        Group[]
  groupMemberships   GroupMember[]
  groupMemberOverrides GroupMemberOverride[]
  orders Order[]
  
  files              File[]
  
  conversationMembers ConversationMember[]
  sentMessages        Message[]
  
  notifications      Notification[]
  
  progressLogs       ProgressLog[]
  coachNotes         ProgressNote[] @relation("CoachNotes")
  studentNotes       ProgressNote[] @relation("StudentNotes")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByHash   String?   @map("replaced_by_hash") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar(255)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ==============================================
// Sport
// ==============================================

model Sport {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  coachStudents CoachStudent[]
  memberships   Membership[]

  @@index([isActive, sortOrder])
  @@map("sports")
}

// ==============================================
// CoachStudent
// ==============================================

model CoachStudent {
  id              String                @id @default(uuid()) @db.Uuid
  coachId         String                @map("coach_id") @db.Uuid
  studentId       String                @map("student_id") @db.Uuid
  sportId         String                @map("sport_id") @db.Uuid
  status          CoachStudentStatus    @default(PENDING)
  initiatedBy     CoachStudentInitiator @map("initiated_by")
  
  startedAt       DateTime?             @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?             @map("ended_at") @db.Timestamptz(3)
  endedReason     String?               @map("ended_reason") @db.VarChar(500)
  leftAt          DateTime?             @map("left_at") @db.Timestamptz(3)  // ← فیلد جدید
  
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  
  coach           User                  @relation("Coach", fields: [coachId], references: [id], onDelete: Cascade)
  student         User                  @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)
  sport           Sport                 @relation(fields: [sportId], references: [id])

  @@unique([coachId, studentId, sportId])
  @@index([coachId, status])
  @@index([studentId, status])
  @@index([sportId, status])
  @@map("coach_students")
}

// ==============================================
// Membership
// ==============================================

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  sportId   String           @map("sport_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  startsAt  DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime         @map("ends_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([sportId, status])
  @@index([endsAt])
  @@map("memberships")
}

// ==============================================
// Exercise
// ==============================================

model Exercise {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  muscleGroup String?  @map("muscle_group") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  programExercises ProgramExercise[]

  @@map("exercises")
}

// ==============================================
// Program
// ==============================================

model Program {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  coachId     String   @map("coach_id") @db.Uuid
  isTemplate  Boolean  @default(false) @map("is_template")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  
  coach           User              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  days            ProgramDay[]
  assignments     ProgramAssignment[]
  versions        ProgramVersion[]

  @@index([coachId])
  @@map("programs")
}

// ==============================================
// ProgramDay
// ==============================================

model ProgramDay {
  id        String @id @default(uuid()) @db.Uuid
  programId String @map("program_id") @db.Uuid
  dayOfWeek Int    @map("day_of_week")
  name      String @db.VarChar(100)
  
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]

  @@unique([programId, dayOfWeek])
  @@map("program_days")
}

// ==============================================
// ProgramExercise
// ==============================================

model ProgramExercise {
  id         String @id @default(uuid()) @db.Uuid
  dayId      String @map("day_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid
  sets       Int    @default(3)
  reps       Int    @default(10)
  weight     Float?
  restTime   Int?   @map("rest_time")
  order      Int    @default(0)
  
  day      ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id])
  logs     ExerciseLog[]

  @@index([dayId])
  @@map("program_exercises")
}

// ==============================================
// ProgramAssignment
// ==============================================

model ProgramAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  studentId  String?  @map("student_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  isActive   Boolean  @default(true) @map("is_active")
  
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  student User?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([programId, studentId])
  @@unique([programId, groupId])
  @@index([studentId, isActive])
  @@index([groupId, isActive])
  @@map("program_assignments")
}

// ==============================================
// ExerciseLog
// ==============================================

model ExerciseLog {
  id                String   @id @default(uuid()) @db.Uuid
  programExerciseId String   @map("program_exercise_id") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  actualSets        Int      @map("actual_sets")
  actualReps        Int      @map("actual_reps")
  actualWeight      Float?   @map("actual_weight")
  notes             String?  @db.Text
  performedAt       DateTime @default(now()) @map("performed_at") @db.Timestamptz(3)
  
  programExercise ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  student         User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, performedAt])
  @@map("exercise_logs")
}

// ==============================================
// Group
// ==============================================

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  coachId     String   @map("coach_id") @db.Uuid
  capacity    Int      @default(10)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  coach   User          @relation(fields: [coachId], references: [id], onDelete: Cascade)
  members GroupMember[]
  assignments ProgramAssignment[]
  memberOverrides GroupMemberOverride[]

  @@index([coachId, isActive])
  @@map("groups")
}

// ==============================================
// GroupMember
// ==============================================

model GroupMember {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ==============================================
// GroupMemberOverride
// ==============================================

model GroupMemberOverride {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  overrides Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_member_overrides")
}

// ==============================================
// ProgramVersion
// ==============================================

model ProgramVersion {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  version   Int
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, version])
  @@map("program_versions")
}

// ==============================================
// File
// ==============================================

model File {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  originalName String   @map("original_name") @db.VarChar(255)
  storedName   String   @map("stored_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  size         Int
  type         FileType
  path         String   @db.VarChar(500)
  isPrivate    Boolean  @default(true) @map("is_private")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([ownerId])
  @@index([type])
  @@map("files")
}

// ==============================================
// Chat
// ==============================================

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType @default(PRIVATE)
  title     String?          @db.VarChar(150)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(3)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  content        String?  @db.Text
  fileId         String?  @map("file_id") @db.Uuid
  replyToId      String?  @map("reply_to_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  file         File?        @relation(fields: [fileId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ==============================================
// Notification
// ==============================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ==============================================
// ProgressLog
// ==============================================

model ProgressLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  weight      Float?
  bodyFat     Float?   @map("body_fat")
  chest       Float?
  waist       Float?
  hips        Float?
  arms        Float?
  legs        Float?
  notes       String?  @db.Text
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)  // ← فیلد جدید

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("progress_logs")
}

// ==============================================
// ProgressNote
// ==============================================

model ProgressNote {
  id         String   @id @default(uuid()) @db.Uuid
  coachId    String   @map("coach_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)  // ← فیلد جدید

  coach   User @relation("CoachNotes", fields: [coachId], references: [id], onDelete: Cascade)
  student User @relation("StudentNotes", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([coachId])
  @@map("progress_notes")
}
// ==============================================
// Subscription & Payment (اشتراک و پرداخت - فاز ۱۵)
// ==============================================

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model SubscriptionPlan {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  description String?      @db.Text
  price       Int          // قیمت به تومان
  interval    PlanInterval @default(MONTHLY)
  durationDays Int         @map("duration_days") // مدت اعتبار به روز
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("subscription_plans")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  planId     String      @map("plan_id") @db.Uuid
  amount     Int         // مبلغ نهایی
  status     OrderStatus @default(PENDING)
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId, status])
  @@index([idempotencyKey])
  @@map("orders")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  amount        Int
  status        PaymentStatus @default(PENDING)
  gatewayName   String?       @map("gateway_name") @db.VarChar(50) // نام درگاه
  transactionId String?       @unique @map("transaction_id") @db.VarChar(255) // شناسه تراکنش
  authority     String?       @unique @db.VarChar(255) // کد رهگیری درگاه
  refId         String?       @map("ref_id") @db.VarChar(255) // شناسه مرجع پرداخت
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}